# Copy to .env and edit. docker compose reads this file automatically.

# Absolute path of the directory to scan. It is mounted read-only and MUST be
# a folder the account running the container is allowed to read.
SCAN_ROOT=/vol1/1000/其他

# Port on the host. Keep it on your LAN; do not expose it to the internet.
HOST_PORT=8080
# Use 127.0.0.1 if you only open the UI from the NAS itself.
BIND_ADDR=0.0.0.0

# Container identity. On fnOS the restricted account dsh-test is uid/gid 1001;
# on a normal Linux laptop your own uid/gid (often 1000). The ./data directory
# must be writable by this identity:  sudo chown -R 1001:1001 ./data
APP_UID=1001
APP_GID=1001

TZ=Asia/Shanghai
