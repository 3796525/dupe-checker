# Copy to .env and edit. docker compose reads this file automatically.

# Absolute path of the directory to scan. It is mounted read-only and MUST be
# a folder the account running the container is allowed to read.
SCAN_ROOT=/vol1/1000/其他

# Port on the host. Keep it on your LAN; do not expose it to the internet.
HOST_PORT=8080
# Use 127.0.0.1 if you only open the UI from the NAS itself.
BIND_ADDR=0.0.0.0

# Container identity. On fnOS the restricted account dsh-test is uid/gid 1001;
# on a normal Linux laptop your own uid/gid (often 1000). The ./data directory
# must be writable by this identity:  sudo chown -R 1001:1001 ./data
APP_UID=1001
APP_GID=1001

TZ=Asia/Shanghai

# Login mode. "password" (default) asks for a password; "none" opens the UI
# without a login and is only for a trusted LAN (this tool is read-only and
# cannot delete anything, but anyone reaching the port can see file lists and
# start scans).  AUTH_MODE=none still issues a CSRF-protected session.
# AUTH_MODE=password

# Session lifetime in seconds (default 8h). Logout revokes all sessions server-side.
# SESSION_TTL_SECONDS=28800

# Cookie Secure flag: auto (default) / always / never.
# Set to always when serving over a TLS reverse proxy.
# SESSION_COOKIE_SECURE=auto

# Read-only guard re-check interval in seconds (default 1800, min 60).
# GUARD_INTERVAL_SECONDS=1800

# Optional first-run setup token. If empty, one is generated and printed in the
# container logs; it is deleted right after the admin password is set.
# DUPE_SETUP_TOKEN=
